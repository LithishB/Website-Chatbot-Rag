# All optional. With nothing set the bot runs locally using tiers T0-T3 and T5.
ANTHROPIC_API_KEY=        # enables T4 (small LLM)
LLM_MODEL=claude-haiku-5-5
TURNSTILE_SECRET=         # empty = skip bot check (dev only)
SESSION_SECRET=change-me
REDIS_URL=                # empty = in-process cache
TRUST_PROXY=0             # 1 when behind a proxy that sets X-Forwarded-For
ADMIN_TOKEN=              # enables /v1/admin/*
